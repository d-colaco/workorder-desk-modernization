<Window x:Class="WorkOrderDesk.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Work order" Width="900" Height="560" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="8">
    <TextBlock x:Name="Header" DockPanel.Dock="Top" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
      <Button Content="Scrap..." Width="80" Click="Scrap_Click"/>
      <Button Content="Close work order" Width="120" Margin="12,0,0,0" Click="Close_Click"/>
    </StackPanel>
    <GroupBox DockPanel.Dock="Bottom" Header="Record selected operation" Margin="0,8,0,0">
      <StackPanel Orientation="Horizontal" Margin="6">
        <TextBlock Text="Start" VerticalAlignment="Center"/>
        <TextBox x:Name="ActStart" Width="130" Margin="6,0,12,0"/>
        <TextBlock Text="End" VerticalAlignment="Center"/>
        <TextBox x:Name="ActEnd" Width="130" Margin="6,0,12,0"/>
        <TextBlock Text="Hours" VerticalAlignment="Center"/>
        <TextBox x:Name="ActHrs" Width="60" Margin="6,0,12,0"/>
        <TextBlock Text="Cost" VerticalAlignment="Center"/>
        <TextBox x:Name="ActCost" Width="70" Margin="6,0,12,0"/>
        <Button Content="Record" Width="70" Click="Record_Click"/>
      </StackPanel>
    </GroupBox>
    <DataGrid x:Name="Routing" AutoGenerateColumns="True" IsReadOnly="True" SelectionMode="Single"
              SelectionChanged="Routing_SelectionChanged" Margin="0,0,0,0"/>
  </DockPanel>
</Window>
