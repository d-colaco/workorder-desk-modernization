<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" /></startup>
  <appSettings>
    <!-- OTLP/HTTP collector; rewritten by `make wpf-deploy`. Leave empty to turn tracing off. -->
    <add key="OtlpEndpoint" value="http://192.168.122.1:32135/v1/traces" />
  </appSettings>
  <connectionStrings>
    <!-- Rewritten by `make wpf-deploy` from .env. Never sa. -->
    <add name="AdventureWorks" connectionString="Server=192.168.122.1,32131;Database=AdventureWorks2022;User Id=lab_app;Password=CHANGE_ME;Application Name=WorkOrderDesk" />
  </connectionStrings>
</configuration>
