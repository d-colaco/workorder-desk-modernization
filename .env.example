# `make setup` writes .env from this file with a random password for each *_PASSWORD (scripts/make_env.py).
# If you copy it by hand instead, change the passwords. Local lab only: every port is bound to loopback or the libvirt bridge.
MSSQL_SA_PASSWORD=Lab_change_me_1
# SQL login used by the WPF client and the sync workers (never sa)
LAB_APP_PASSWORD=Lab_change_me_2
MSSQL_MEMORY_LIMIT_MB=2048
# Host binds for SQL Server (port 32131). The second address is the libvirt bridge, so the WPF VM reaches it.
MSSQL_BIND_LOCAL=127.0.0.1
MSSQL_BIND_VM=192.168.122.1

POSTGRES_PASSWORD=Lab_change_me_3

RABBITMQ_PASSWORD=Lab_change_me_4
